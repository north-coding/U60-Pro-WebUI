{
  "schema_version": 1,
  "plan_id": "u60-single-mihomo-cutover-v1",
  "execution_mode": "dry-run-only",
  "device_mutations_supported": false,
  "ownership_classes": [
    "stock_zte_protected",
    "project_owned",
    "mihomo_owned",
    "unknown"
  ],
  "protected_components": [
    {
      "id": "stock-cellular-and-apn",
      "classification": "stock_zte_protected",
      "description": "Cellular service, SIM/eSIM state, APN profiles, and WAN interfaces.",
      "paths": ["/etc/config/network"]
    },
    {
      "id": "stock-wifi-and-router-management",
      "classification": "stock_zte_protected",
      "description": "Stock Wi-Fi, LAN/DHCP, firewall, router UI, and ZTE system services.",
      "paths": ["/etc/config/wireless", "/etc/config/firewall", "/etc/config/zte_topsw_daemon.conf"]
    },
    {
      "id": "root-ssh-and-keys",
      "classification": "stock_zte_protected",
      "description": "Root Dropbear service, host/client keys, and installed project-owned SSH launcher.",
      "paths": ["/etc/dropbear", "/data/bin/dropbear", "/data/local/tmp/start_dropbear.sh"]
    },
    {
      "id": "usb-ecm-and-configfs",
      "classification": "stock_zte_protected",
      "description": "USB ECM composition, ConfigFS state, saved USB mode, and the live usb_op node.",
      "paths": ["/data/local/tmp/usb_config.json", "/sys/devices/virtual/android_usb/android0/usb_op"]
    },
    {
      "id": "stock-dashboard-and-rc-local-body",
      "classification": "stock_zte_protected",
      "description": "Stock WebUI and full rc.local body; only the exact project-owned Agent startup entry may be changed after checks.",
      "paths": ["/data/www", "/data/www.current", "/etc/rc.local"]
    }
  ],
  "protected_paths": [
    "/etc/config/zte_topsw_daemon.conf",
    "/etc/config/wireless",
    "/etc/config/network",
    "/etc/config/firewall",
    "/etc/dropbear",
    "/data/bin/dropbear",
    "/data/local/tmp/start_dropbear.sh",
    "/data/local/tmp/start_dashboard.sh",
    "/data/local/tmp/usb_config.json",
    "/data/www",
    "/data/www.current",
    "/sys/devices/virtual/android_usb/android0/usb_op"
  ],
  "protected_path_prefixes": [
    "/etc/init.d",
    "/etc/rc.d",
    "/zteoverlay",
    "/sys/class/net"
  ],
  "single_instance_storage": {
    "root": "/data/u60-pro-managed",
    "root_mode": "0700",
    "execution_mode": "one-agent-one-mihomo",
    "legacy_data_is_migrated": false,
    "owner_id": "u60-proxy-managed",
    "runtime_owners": [
      {"owner_id": "u60-proxy-agent", "classification": "project_owned"},
      {"owner_id": "managed-mihomo", "classification": "mihomo_owned"},
      {"owner_id": "u60-proxy-managed", "classification": "project_owned"}
    ],
    "staging_path": "/data/u60-pro-managed/staging",
    "staging_is_temporary": true,
    "managed_runtime_paths": [
      {"id": "managed-agent-dir", "path": "/data/u60-pro-managed/agent", "kind": "directory", "classification": "project_owned", "owner_id": "u60-proxy-agent"},
      {"id": "managed-agent-binary", "path": "/data/u60-pro-managed/agent/zte-agent", "kind": "file", "classification": "project_owned", "owner_id": "u60-proxy-agent"},
      {"id": "managed-agent-binary-sha256", "path": "/data/u60-pro-managed/agent/zte-agent.sha256", "kind": "file", "classification": "project_owned", "owner_id": "u60-proxy-agent"},
      {"id": "managed-agent-binary-arch", "path": "/data/u60-pro-managed/agent/zte-agent.arch", "kind": "file", "classification": "project_owned", "owner_id": "u60-proxy-agent"},
      {"id": "managed-agent-startup", "path": "/data/u60-pro-managed/agent/start-proxy-agent.sh", "kind": "file", "classification": "project_owned", "owner_id": "u60-proxy-agent"},
      {"id": "managed-auth-dir", "path": "/data/u60-pro-managed/auth", "kind": "directory", "classification": "project_owned", "owner_id": "u60-proxy-agent"},
      {"id": "managed-auth-password", "path": "/data/u60-pro-managed/auth/password", "kind": "file", "classification": "project_owned", "owner_id": "u60-proxy-agent"},
      {"id": "managed-auth-salt", "path": "/data/u60-pro-managed/auth/salt", "kind": "file", "classification": "project_owned", "owner_id": "u60-proxy-agent"},
      {"id": "managed-mihomo-dir", "path": "/data/u60-pro-managed/mihomo", "kind": "directory", "classification": "mihomo_owned", "owner_id": "managed-mihomo"},
      {"id": "managed-mihomo-binary", "path": "/data/u60-pro-managed/mihomo/mihomo", "kind": "file", "classification": "mihomo_owned", "owner_id": "managed-mihomo"},
      {"id": "managed-mihomo-binary-sha256", "path": "/data/u60-pro-managed/mihomo/mihomo.sha256", "kind": "file", "classification": "mihomo_owned", "owner_id": "managed-mihomo"},
      {"id": "managed-mihomo-binary-arch", "path": "/data/u60-pro-managed/mihomo/mihomo.arch", "kind": "file", "classification": "mihomo_owned", "owner_id": "managed-mihomo"},
      {"id": "managed-mihomo-config", "path": "/data/u60-pro-managed/mihomo/config.yaml", "kind": "file", "classification": "mihomo_owned", "owner_id": "managed-mihomo"},
      {"id": "managed-mihomo-staged-config", "path": "/data/u60-pro-managed/mihomo/config.staged.yaml", "kind": "file", "classification": "mihomo_owned", "owner_id": "managed-mihomo"},
      {"id": "managed-mihomo-state", "path": "/data/u60-pro-managed/mihomo/manager.json", "kind": "file", "classification": "mihomo_owned", "owner_id": "managed-mihomo"},
      {"id": "managed-mihomo-providers", "path": "/data/u60-pro-managed/mihomo/providers", "kind": "directory", "classification": "mihomo_owned", "owner_id": "managed-mihomo"},
      {"id": "managed-mihomo-profiles", "path": "/data/u60-pro-managed/mihomo/profiles", "kind": "directory", "classification": "mihomo_owned", "owner_id": "managed-mihomo"},
      {"id": "managed-mihomo-cn-list", "path": "/data/u60-pro-managed/mihomo/cn.list", "kind": "file", "classification": "mihomo_owned", "owner_id": "managed-mihomo"},
      {"id": "managed-mihomo-controller-socket", "path": "/data/u60-pro-managed/mihomo/mihomo.sock", "kind": "socket", "classification": "mihomo_owned", "owner_id": "managed-mihomo"},
      {"id": "managed-mihomo-ui", "path": "/data/u60-pro-managed/mihomo/ui", "kind": "directory", "classification": "mihomo_owned", "owner_id": "managed-mihomo"},
      {"id": "managed-mihomo-log", "path": "/data/u60-pro-managed/mihomo/mihomo.log", "kind": "file", "classification": "mihomo_owned", "owner_id": "managed-mihomo"},
      {"id": "managed-mihomo-owner-record", "path": "/data/u60-pro-managed/mihomo/mihomo.pid", "kind": "file", "classification": "mihomo_owned", "owner_id": "managed-mihomo", "format": "0600 JSON containing PID, start ticks, executable device/inode/SHA-256, exact argv paths, process owner token, schema and phase"},
      {"id": "managed-mihomo-manager-lock", "path": "/data/u60-pro-managed/mihomo/manager.lock", "kind": "file", "classification": "project_owned", "owner_id": "u60-proxy-agent"},
      {"id": "temporary-staging-dir", "path": "/data/u60-pro-managed/staging", "kind": "directory", "classification": "project_owned", "owner_id": "u60-proxy-managed", "temporary": true},
      {"id": "startup-transaction-dir", "path": "/data/u60-pro-managed/staging/startup-transaction", "kind": "directory", "classification": "project_owned", "owner_id": "u60-proxy-managed", "temporary": true},
      {"id": "startup-transaction-original", "path": "/data/u60-pro-managed/staging/startup-transaction/original.rc.local", "kind": "file", "classification": "project_owned", "owner_id": "u60-proxy-managed", "temporary": true, "mode": "0400"},
      {"id": "startup-transaction-metadata", "path": "/data/u60-pro-managed/staging/startup-transaction/metadata.json", "kind": "file", "classification": "project_owned", "owner_id": "u60-proxy-managed", "temporary": true, "mode": "0400"},
      {"id": "startup-transaction-state", "path": "/data/u60-pro-managed/staging/startup-transaction/state.json", "kind": "file", "classification": "project_owned", "owner_id": "u60-proxy-managed", "temporary": true, "mode": "0600"},
      {"id": "startup-transaction-lock", "path": "/data/u60-pro-managed/staging/startup-transaction.lock", "kind": "file", "classification": "project_owned", "owner_id": "u60-proxy-managed", "temporary": true, "mode": "0600"}
    ],
    "cleanup_separation": "Every managed runtime path must remain disjoint from every legacy cleanup target. Unknown, shared, or overlapping ownership blocks all cleanup planning."
  },
  "management_transport": {
    "agent_bind": "127.0.0.1:9090",
    "agent_transport": "plain_http_loopback_only",
    "remote_plain_http_credentials_allowed": false,
    "https_termination_provided": false,
    "forwarded_client_address_headers_trusted": false,
    "source_aware_login_throttling": "deployment_blocker_behind_loopback_gateway",
    "proxy_only_password": {"format": "canonical unpadded base64url encoding of 32 random bytes", "length": 43, "path": "/data/u60-pro-managed/auth/password", "mode": "0600", "legacy_full_agent_auth_changed": false},
    "proxy_only_dashboard_features": ["subscriptions", "nodes", "overview", "settings"],
    "unrelated_router_endpoints_in_proxy_only_mode": "404_or_denied",
    "deployment_gate": "provide_and_independently_review_a_trusted_https_path_before_iPhone_or_other_LAN_management"
  },
  "startup_activation_transaction": {
    "implementation": "scripts/device/startup_transaction.py",
    "execution_mode": "marked_temporary_synthetic_root_only",
    "device_execution_enabled": false,
    "target": "/etc/rc.local",
    "snapshot_path": "/data/u60-pro-managed/staging/startup-transaction/original.rc.local",
    "snapshot_mode": "0400",
    "snapshot_integrity": "sha256 plus original owner, group, mode, device and inode metadata",
    "candidate_entry": "sh /data/u60-pro-managed/agent/start-proxy-agent.sh start",
    "replace_policy": "replace only one exact unchanged project-owned old Agent entry; preserve all other bytes",
    "health_check": {"auth": "loopback capability discovery, password login, bearer-authenticated proxy status", "total_timeout_seconds": 8, "per_request_timeout_seconds": 1, "attempts": 8},
    "rollback_policy": "remove only the exact new proxy-only startup entry; retain the original snapshot; never restore the abandoned legacy startup entry",
    "process_and_network_cleanup": "none; do not stop unverified processes or delete routes, firewall rules, interfaces, or legacy Mihomo files"
  },
  "legacy_installers": [
    {
      "id": "legacy-mihomo-installer",
      "path": "scripts/deploy-mihomo.sh",
      "writes_to": "/data/mihomo",
      "permitted_for_managed_runtime": false,
      "status": "legacy_only_not_for_cutover"
    }
  ],
  "candidate_cleanup_targets": [
    {
      "id": "legacy-agent-binary",
      "path": "/data/zte-agent",
      "kind": "file",
      "classification": "project_owned",
      "owner_id": "u60-project-agent",
      "action": "replace_after_verified_staging"
    },
    {
      "id": "legacy-agent-startup",
      "path": "/data/local/tmp/start_zte_agent.sh",
      "kind": "file",
      "classification": "project_owned",
      "owner_id": "u60-project-agent",
      "action": "replace_after_verified_staging"
    },
    {
      "id": "legacy-mihomo-binary",
      "path": "/data/mihomo/mihomo",
      "kind": "file",
      "classification": "mihomo_owned",
      "owner_id": "legacy-mihomo",
      "action": "remove_exact_file_after_cutover"
    },
    {
      "id": "legacy-mihomo-config",
      "path": "/data/mihomo/config.yaml",
      "kind": "file",
      "classification": "mihomo_owned",
      "owner_id": "legacy-mihomo",
      "action": "remove_exact_file_after_cutover"
    },
    {
      "id": "legacy-mihomo-manager-state",
      "path": "/data/mihomo/manager.json",
      "kind": "file",
      "classification": "mihomo_owned",
      "owner_id": "legacy-mihomo",
      "action": "remove_exact_file_after_cutover"
    },
    {
      "id": "legacy-mihomo-cn-list",
      "path": "/data/mihomo/cn.list",
      "kind": "file",
      "classification": "mihomo_owned",
      "owner_id": "legacy-mihomo",
      "action": "remove_exact_file_after_cutover"
    },
    {
      "id": "legacy-mihomo-provider-cache",
      "path": "/data/mihomo/providers",
      "kind": "directory",
      "classification": "mihomo_owned",
      "owner_id": "legacy-mihomo",
      "action": "remove_only_after_complete_child_inventory"
    },
    {
      "id": "legacy-mihomo-profile-cache",
      "path": "/data/mihomo/profiles",
      "kind": "directory",
      "classification": "mihomo_owned",
      "owner_id": "legacy-mihomo",
      "action": "remove_only_after_complete_child_inventory"
    },
    {
      "id": "legacy-mihomo-panel",
      "path": "/data/mihomo/ui",
      "kind": "directory",
      "classification": "mihomo_owned",
      "owner_id": "legacy-mihomo",
      "action": "remove_only_after_complete_child_inventory"
    },
    {
      "id": "legacy-mihomo-pid",
      "path": "/var/run/mihomo.pid",
      "kind": "file",
      "classification": "mihomo_owned",
      "owner_id": "legacy-mihomo",
      "action": "remove_exact_file_after_process_stop"
    },
    {
      "id": "legacy-mihomo-log",
      "path": "/tmp/mihomo.log",
      "kind": "file",
      "classification": "mihomo_owned",
      "owner_id": "legacy-mihomo",
      "action": "remove_exact_file_after_process_stop"
    },
    {
      "id": "legacy-agent-rc-local-entry",
      "path": "/etc/rc.local",
      "kind": "startup_entry",
      "classification": "project_owned",
      "owner_id": "u60-project-agent",
      "exact_entry": "sh /data/local/tmp/start_zte_agent.sh",
      "replacement_entry": "sh /data/u60-pro-managed/agent/start-proxy-agent.sh start",
      "action": "replace_exact_entry_only"
    }
  ],
  "managed_services": [
    {"name": "zte-agent", "owner_id": "u60-project-agent"},
    {"name": "legacy-mihomo", "owner_id": "legacy-mihomo"},
    {"name": "proxy-only-agent", "owner_id": "u60-proxy-agent"},
    {"name": "managed-mihomo", "owner_id": "managed-mihomo"}
  ],
  "required_artifacts": [
    {"id": "new-agent", "path": "/data/u60-pro-managed/agent/zte-agent", "arch": "aarch64", "purpose": "staged authenticated proxy-management Agent"},
    {"id": "mihomo-binary", "path": "/data/u60-pro-managed/mihomo/mihomo", "arch": "aarch64", "purpose": "single new managed Mihomo binary"},
    {"id": "new-agent-sha256", "path": "/data/u60-pro-managed/agent/zte-agent.sha256", "arch": null, "purpose": "verified artifact identity sidecar required by the launcher"},
    {"id": "new-agent-arch", "path": "/data/u60-pro-managed/agent/zte-agent.arch", "arch": null, "purpose": "aarch64 build declaration checked against the binary build info"},
    {"id": "mihomo-sha256", "path": "/data/u60-pro-managed/mihomo/mihomo.sha256", "arch": null, "purpose": "verified artifact identity sidecar required by the launcher"},
    {"id": "mihomo-arch", "path": "/data/u60-pro-managed/mihomo/mihomo.arch", "arch": null, "purpose": "aarch64 build declaration checked against Mihomo version output"},
    {"id": "managed-auth-password", "path": "/data/u60-pro-managed/auth/password", "arch": null, "purpose": "owner-only 0600 canonical base64url credential generated from 32 random bytes, never printed or placed in the Agent environment"},
    {"id": "fresh-mihomo-config", "path": "/data/u60-pro-managed/mihomo/config.yaml", "arch": null, "required_before_mihomo_start": true, "purpose": "generated from new managed settings and syntax-checked by the Agent immediately before start; no old config import"},
    {"id": "new-startup-script", "path": "/data/u60-pro-managed/agent/start-proxy-agent.sh", "arch": null, "purpose": "explicit launcher contract invokes zte-agent --proxy-only --proxy-bind 127.0.0.1:9090"},
    {"id": "startup-transaction-snapshot", "path": "/data/u60-pro-managed/staging/startup-transaction/original.rc.local", "arch": null, "purpose": "complete protected original startup file, written and verified before exact-entry replacement; excludes abandoned Mihomo configuration and provider data"}
  ],
  "rollback_scope": {
    "preserve": ["the complete pre-change rc.local snapshot and its digest/identity metadata", "all unrelated rc.local bytes", "existing auth inputs without exposing them", "stock router services"],
    "exclude": ["old Mihomo configuration", "old subscriptions and provider cache", "stock firmware, SSH keys, USB assets, and cellular/Wi-Fi configuration"],
    "fallback": "remove only the exact new proxy-only startup entry and retain the verified original snapshot; do not start the abandoned legacy Agent or Mihomo, stop unverified processes, or change network resources"
  },
  "offline_preparation_checks": [
    "artifact_hashes_verified",
    "fresh_config_validated",
    "startup_script_syntax_validated",
    "rollback_snapshot_complete",
    "rc_local_snapshot_complete",
    "startup_transaction_exact_entry_rollback_ready",
    "startup_transaction_authenticated_health_bounded",
    "new_service_stop_recovery_checked",
    "stock_paths_excluded_from_mutations"
  ],
  "failure_recovery_checks": [
    "startup_transaction_exact_entry_rollback_ready",
    "startup_transaction_recovery_fail_closed",
    "new_service_stop_recovery_checked",
    "stock_paths_excluded_from_mutations"
  ],
  "activation_checks": [
    "authenticated_proxy_management_only_startup",
    "proxy_api_authentication_verified",
    "mihomo_controller_health_verified",
    "manual_subscription_refresh_verified",
    "rule_mode_cn_direct_foreign_proxy_verified",
    "wifi_client_data_plane_verified",
    "stock_cellular_wifi_usb_ssh_services_verified"
  ],
  "minimum_authenticated_management_startup_work": [
    {
      "id": "early-mode-dispatch",
      "files": ["agent/src/main.rs"],
      "requirement": "Parse an explicit proxy-management-only mode before migration or any legacy boot initialization; preserve zero-argument behavior only for the existing legacy path.",
      "status": "implemented_offline_candidate"
    },
    {
      "id": "minimal-proxy-state",
      "files": ["agent/src/handlers.rs", "agent/src/mihomo/mod.rs"],
      "requirement": "Construct only password authentication and the Mihomo manager; do not initialize unrelated device managers or recovery journals.",
      "status": "implemented_offline_candidate"
    },
    {
      "id": "proxy-route-allowlist",
      "files": ["agent/src/server.rs"],
      "requirement": "Allow login and exact proxy-management routes; return 404 for every other API route while retaining bearer authentication and body limits. PAC is not exposed in proxy-only mode.",
      "status": "implemented_offline_candidate"
    },
    {
      "id": "skip-legacy-side-effects",
      "files": ["agent/src/main.rs"],
      "requirement": "Do not run migration cleanup, event bus, charge/SMS/client-traffic workers, persisted TTL script, USB enforcement, or LAN recovery in proxy-management-only mode.",
      "status": "implemented_offline_candidate"
    },
    {
      "id": "credential-and-binding-gate",
      "files": ["agent/src/main.rs", "agent/src/lan.rs", "agent/src/auth.rs"],
      "requirement": "Require an explicitly configured managed password and keep loopback-only binding until HTTPS is implemented and independently reviewed; keep password lockout/token checks; make no SSH credential changes.",
      "status": "implemented_offline_candidate_remote_https_blocked"
    },
    {
      "id": "startup-activation-contract",
      "files": ["agent/src/proxy_only.rs", "scripts/device/start-proxy-agent.sh", "scripts/device/prepare-proxy-rc-local.py", "scripts/device/startup_transaction.py"],
      "requirement": "For offline verification, require a protected complete snapshot, exact project-owned entry, shell syntax, verified artifact hashes/architectures/paths, and bounded authenticated health before changing a marked synthetic rc.local. Roll back by removing only the new entry; preserve stock bytes and never restore the abandoned legacy entry. Device execution remains disabled.",
      "status": "implemented_and_tested_synthetic_only_device_execution_disabled"
    },
    {
      "id": "offline-startup-tests",
      "files": ["agent/src/main.rs", "agent/src/server.rs"],
      "requirement": "Test that legacy initialization hooks do not run in this mode, non-proxy endpoints are denied, missing credentials fail closed, and proxy routes remain authenticated.",
      "status": "implemented_offline_candidate"
    }
  ],
  "failure_recovery_conditions": [
    "Keep a complete mode-0400 original rc.local snapshot and remove only the exact new proxy-only entry on rollback; never restore the abandoned legacy Agent entry.",
    "Do not stop processes as part of the startup-file transaction; process cleanup requires separately verified ownership and approval.",
    "Leave Mihomo-owned resources untouched when process or path ownership is unknown.",
    "Do not remove a live process, route, firewall rule, SSH component, USB asset, or stock service during recovery.",
    "Require shell syntax, artifact identity, path, rollback snapshot and bounded authenticated health validation before a synthetic startup-entry replacement; device mutation is disabled."
  ],
  "routing_policy": {
    "automatic_cleanup_targets": [],
    "conflict_rule_priority_range": [9000, 9099],
    "conflict_route_table": "2022",
    "check_before_both_tun_and_non_tun_starts": true,
    "on_conflict": "fail_closed_and_require_read_only_owner_review"
  }
}
